public type Comment record {
    *GenericObject;
    # Unique numeric identifier of the comment.
    int id?;
    # Timestamp of the created on of the comment.
    string created_on?;
    # Timestamp of the updated on of the comment.
    string updated_on?;
    # The content of the comment.
    Comment_content content?;
    # The user associated with the comment.
    Account user?;
    # Indicates whether the comment has deleted.
    boolean deleted?;
    # The parent of the comment.
    Comment parent?;
    # The inline of the comment.
    Comment_inline inline?;
    # Hypermedia links related to the comment.
    Comment_links links?;
};

public type PipelineRunnerState record {
    *GenericObject;
    # The current status of the runner.
    "UNREGISTERED"|"ONLINE"|"OFFLINE"|"DISABLED"|"ENABLED"|"UNHEALTHY" status?;
    # The version of the pipeline runner state.
    PipelineRunnerVersion version?;
    # The timestamp when the runner state was last updated.
    string updated_on?;
    # Whether the runner is cordoned (prevented from accepting new steps).
    boolean cordoned?;
};

# The resolution object for a Comment
public type CommentResolution record {
    # Discriminator that identifies the type of this object.
    string 'type;
    # The user associated with the comment resolution.
    Account user?;
    # The ISO8601 timestamp the resolution was created.
    string created_on?;
};

public type WebhookSubscription record {
    *GenericObject;
    # The webhook's id
    string uuid?;
    # The URL events get delivered to.
    string url?;
    # A user-defined description of the webhook.
    string description?;
    # The type of entity. Set to either `repository` or `workspace` based on where the subscription is defined.
    "repository"|"workspace" subject_type?;
    # The subject of the webhook subscription.
    GenericObject subject?;
    # Indicates whether the webhook subscription has active.
    boolean active?;
    # Timestamp of the created at of the webhook subscription.
    string created_at?;
    # The events this webhook is subscribed to.
    ("issue:comment_created"|"issue:created"|"issue:updated"|"pipeline:span_created"|"project:updated"|"pullrequest:approved"|"pullrequest:changes_request_created"|"pullrequest:changes_request_removed"|"pullrequest:comment_created"|"pullrequest:comment_deleted"|"pullrequest:comment_reopened"|"pullrequest:comment_resolved"|"pullrequest:comment_updated"|"pullrequest:created"|"pullrequest:fulfilled"|"pullrequest:push"|"pullrequest:rejected"|"pullrequest:unapproved"|"pullrequest:updated"|"repo:commit_comment_created"|"repo:commit_status_created"|"repo:commit_status_updated"|"repo:created"|"repo:deleted"|"repo:fork"|"repo:imported"|"repo:push"|"repo:transfer"|"repo:updated")[] events?;
    # Indicates whether or not the hook has an associated secret. It is not possible to see the hook's secret. This field is ignored during updates.
    boolean secret_set?;
    # The secret to associate with the hook. The secret is never returned via the API. As such, this field is only used during updates. The secret can be set to `null` or "" to remove the secret (or create a hook with no secret). Leaving out the secret field during updates will leave the secret unchanged. Leaving out the secret during creation will create a hook with no secret.
    string secret?;
};

public type PipelineStep record {
    *GenericObject;
    # The UUID identifying the step.
    string uuid?;
    # The timestamp when the step execution was started. This is not set when the step hasn't executed yet.
    string started_on?;
    # The timestamp when the step execution was completed. This is not set if the step is still in progress.
    string completed_on?;
    # The state of the pipeline step.
    PipelineStepState state?;
    # The image of the pipeline step.
    PipelineImage image?;
    # The list of commands that are executed as part of the setup phase of the build. These commands are executed outside the build container.
    PipelineCommand[] setup_commands?;
    # The list of build commands. These commands are executed in the build container.
    PipelineCommand[] script_commands?;
};

# Represents the Queries record for the operation: getRootDirectoryMainBranch
public type GetRootDirectoryMainBranchQueries record {
    # Instead of returning the file's contents, return the (json) meta data for it
    "meta" format?;
};

# A diffstat object that includes a summary of changes made to a file between two commits
public type Diffstat record {
    # Discriminator that identifies the type of this object.
    string 'type;
    # The status of the diffstat.
    "added"|"removed"|"modified"|"renamed" status?;
    # Numeric lines added of the diffstat.
    int lines_added?;
    # Numeric lines removed of the diffstat.
    int lines_removed?;
    # The old of the diffstat.
    CommitFile old?;
    # The new of the diffstat.
    CommitFile 'new?;
};

